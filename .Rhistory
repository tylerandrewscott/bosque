library(jsonlite)
library(stringr)
library(pbapply)
rlist <- pblapply(resp,function(r) {
message <- read_json(paste0(dir,r))
js <- message$choices[[1]]$message.content
js_return <- tryCatch(fromJSON(js,flatten = T),error = function(e) NULL)
return(js_return)
},cl = 5)
